<view class="page">
  <view wx:if="{{cloudError}}" class="card error-card">
    <view class="error-title">还没有连接上云服务</view>
    <view class="error-text">请按 README 开通云开发、建好集合并部署 login、friendToday 云函数，然后重新编译</view>
  </view>

  <block wx:else>
    <view class="card code-card">
      <view class="code-title">我的邀请码</view>
      <view class="code-sub">发给朋友，她绑定后就能看到妳今天的打卡进度</view>
      <view class="code-row">
        <view class="code-value">{{myCode}}</view>
        <button class="btn-primary copy-btn" bindtap="copyCode">复制</button>
      </view>
    </view>

    <view class="card bind-card">
      <view class="bind-title">绑定朋友</view>
      <input class="input-soft bind-input" placeholder="粘贴朋友的邀请码" value="{{codeInput}}" bindinput="onCodeInput" />
      <input class="input-soft bind-input" placeholder="给她起个昵称（可选）" value="{{nicknameInput}}" bindinput="onNicknameInput" />
      <button class="btn-primary" bindtap="bindFriend">绑定</button>
    </view>

    <view wx:if="{{!loading && friends.length === 0}}" class="card empty-card">
      <anpanman size="{{160}}" mood="happy" />
      <view class="empty-title">还没有绑定朋友</view>
      <view class="empty-sub">互相绑定后，就能看到彼此今天的进度啦</view>
    </view>

    <view wx:for="{{friends}}" wx:key="friendOpenid" class="card friend-card"
          data-index="{{index}}" bindtap="toggleExpand" bindlongpress="removeBind">
      <view class="friend-head">
        <view class="friend-name">
          {{item.nickname}}
          <text wx:if="{{item.allDone}}" class="friend-badge">全部完成</text>
        </view>
        <view class="friend-num">{{item.doneCount}} / {{item.total}}</view>
      </view>
      <view class="friend-bar">
        <view class="friend-bar-inner" style="width:{{item.percent}}%"></view>
      </view>
      <view wx:if="{{item.total === 0}}" class="friend-empty">她今天还没有安排计划</view>
      <view wx:if="{{item.expanded}}" class="friend-items">
        <view wx:for="{{item.items}}" wx:for-item="it" wx:key="index" class="friend-item">
          <view class="mini-check {{it.done ? 'checked' : ''}}">
            <text wx:if="{{it.done}}" class="mini-mark">✓</text>
          </view>
          <view class="friend-item-body">
            <view class="friend-item-text {{it.done ? 'done' : ''}}">{{it.text}}</view>
            <view class="friend-item-time" wx:if="{{it.timeText}}">{{it.timeText}}</view>
          </view>
        </view>
        <view class="friend-hint">长按卡片可以解除绑定</view>
      </view>
    </view>
  </block>
</view>
