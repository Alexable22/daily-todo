.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.code-card {
  padding: 32rpx;
}
.code-title {
  font-size: 30rpx;
  font-weight: 600;
}
.code-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #B08E8E;
}
.code-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.code-value {
  flex: 1;
  min-width: 0;
  background: #FFF1EC;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #8A6A6A;
  word-break: break-all;
}
.copy-btn {
  flex-shrink: 0;
  width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 0 0 20rpx;
  font-size: 27rpx;
}

.bind-card {
  margin-top: 24rpx;
  padding: 32rpx;
}
.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.bind-input {
  width: 100%;
  margin-bottom: 20rpx;
}

.empty-card {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B08E8E;
}

.friend-card {
  margin-top: 24rpx;
}
.friend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.friend-name {
  font-size: 30rpx;
  font-weight: 600;
}
.friend-badge {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFB1B1, #FF8FA3);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 400;
}
.friend-num {
  font-size: 28rpx;
  color: #FF8FA3;
  font-weight: 700;
}
.friend-bar {
  margin-top: 16rpx;
  height: 14rpx;
  background: #FFECE7;
  border-radius: 999rpx;
  overflow: hidden;
}
.friend-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFC2D1, #FF8FA3);
  transition: width 0.4s ease;
}
.friend-empty {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #B08E8E;
}
.friend-items {
  margin-top: 18rpx;
  border-top: 2rpx solid #FBEFEA;
  padding-top: 10rpx;
}
.friend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.mini-check {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #FFD0D8;
  background: #FFF8F6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mini-check.checked {
  background: linear-gradient(135deg, #FFB1B1, #FF8FA3);
  border-color: #FF8FA3;
}
.mini-mark {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.friend-item-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
.friend-item-text {
  font-size: 27rpx;
  line-height: 1.4;
  word-break: break-all;
}
.friend-item-text.done {
  color: #CDB6B6;
  text-decoration: line-through;
}
.friend-item-time {
  font-size: 22rpx;
  color: #B08E8E;
}
.friend-hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #D8C4C4;
  text-align: center;
}

.error-card {
  margin-top: 80rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}
.error-title {
  font-size: 32rpx;
  font-weight: 600;
}
.error-text {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #B08E8E;
  line-height: 1.6;
}
