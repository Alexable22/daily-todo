.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

/* 星期切换 */
.wd-scroll {
  white-space: nowrap;
}
.wd-row {
  display: flex;
  padding: 8rpx 4rpx;
}
.wd-chip {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #B08E8E;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 163, 0.08);
}
.wd-chip.active {
  background: linear-gradient(135deg, #FFB1B1, #FF8FA3);
  color: #FFFFFF;
  font-weight: 600;
}

/* 导入入口 */
.import-entry {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.import-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #FF8FA3;
}
.import-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #B08E8E;
}
.import-arrow {
  font-size: 44rpx;
  color: #FFD0D8;
  padding-left: 20rpx;
}

/* 空状态 */
.empty-card {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B08E8E;
}

/* 模板项 */
.tpl-item {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
}
.tpl-time {
  flex-shrink: 0;
  width: 176rpx;
  font-size: 24rpx;
  color: #E89AA8;
  font-weight: 600;
}
.tpl-time.no-time {
  color: #BFA3A3;
  font-weight: 400;
}
.tpl-text {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.45;
  word-break: break-all;
}
.tpl-more {
  flex-shrink: 0;
  color: #EBD9D9;
  font-size: 40rpx;
  padding-left: 16rpx;
}

/* 表单 */
.form-card {
  margin-top: 32rpx;
}
.form-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.form-input {
  width: 100%;
}
.time-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.time-pick {
  background: #FFF1EC;
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  font-size: 27rpx;
  color: #6B4F4F;
  min-width: 200rpx;
  text-align: center;
}
.time-pick.placeholder {
  color: #A58383;
}
.time-sep {
  margin: 0 16rpx;
  color: #D8C4C4;
}
.time-clear {
  margin-left: 18rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F3E9E7;
  color: #B08E8E;
  text-align: center;
  line-height: 48rpx;
  font-size: 32rpx;
}
.form-btns {
  display: flex;
  margin-top: 24rpx;
}
.form-btn {
  flex: 1;
  margin: 0 8rpx;
}
