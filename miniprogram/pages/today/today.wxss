.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 12rpx 8rpx;
}
.date {
  font-size: 36rpx;
  font-weight: 600;
  color: #6B4F4F;
}
.greeting {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #B08E8E;
}
.streak {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 20rpx;
  background: #FFE9E4;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #E8736B;
}
.streak-num {
  font-weight: 700;
  font-size: 30rpx;
}

/* 戳一戳吉祥物 */
.mascot-zone {
  position: relative;
  flex-shrink: 0;
}
.mascot-hover {
  opacity: 0.8;
}
.poke-bubble {
  position: absolute;
  top: 100%;
  right: 0;
  z-index: 20;
  margin-top: 14rpx;
  max-width: 340rpx;
  padding: 14rpx 22rpx;
  background: #FF8FA3;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 163, 0.35);
  animation: bubbleIn 0.25s ease-out;
}
.poke-bubble::after {
  content: '';
  position: absolute;
  right: 56rpx;
  top: -10rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 12rpx solid #FF8FA3;
}
@keyframes bubbleIn {
  0% { opacity: 0; transform: translateY(-8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* 勾选瞬间粒子小爆花：JS 两段式 setData（先聚集在圆心，再扩散到外围），这里只负责过渡 */
.burst-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
  pointer-events: none;
}
.burst-p {
  position: absolute;
  border-radius: 30%;
  transition: left 0.55s cubic-bezier(0.15, 0.85, 0.35, 1),
              top 0.55s cubic-bezier(0.15, 0.85, 0.35, 1),
              opacity 0.55s ease-out,
              transform 0.55s cubic-bezier(0.15, 0.85, 0.35, 1);
}
.burst-p.round {
  border-radius: 50%;
}

/* 进度卡 */
.progress-card {
  margin-top: 20rpx;
}
.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  color: #B08E8E;
}
.progress-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF8FA3;
}
.progress-bar {
  margin-top: 16rpx;
  height: 18rpx;
  background: #FFECE7;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFC2D1, #FF8FA3);
  transition: width 0.4s ease;
}
.progress-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #E89AA8;
}

/* 空状态 */
.empty-card {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx;
}
.empty-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #B08E8E;
}
.empty-btn {
  width: 100%;
  margin-top: 24rpx;
}

/* 任务卡 */
.task-list {
  margin-top: 24rpx;
}
.task-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.task-card:active {
  transform: scale(0.985);
}
.check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #FFD0D8;
  background: #FFF8F6;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.check.checked {
  background: linear-gradient(135deg, #FFB1B1, #FF8FA3);
  border-color: #FF8FA3;
}
.check-mark {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
.task-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.task-text {
  font-size: 30rpx;
  color: #6B4F4F;
  line-height: 1.45;
  word-break: break-all;
}
.task-time {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #B08E8E;
}

/* 已完成 */
.task-card.done .task-text {
  color: #CDB6B6;
  text-decoration: line-through;
}
.task-card.done .task-time {
  color: #DCC9C9;
}

/* 进行中：粉色描边高亮 */
.task-card.st-ongoing {
  border: 3rpx solid #FFB1C1;
  background: linear-gradient(135deg, #FFF5F7, #FFFFFF);
}
/* 错过：柔和降饱和，不刺眼 */
.task-card.st-past {
  opacity: 0.72;
}

.tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}
.tag-ongoing {
  background: #FF8FA3;
  color: #FFFFFF;
}
.tag-past {
  background: #F3E9E7;
  color: #B08E8E;
}

/* 庆祝遮罩 */
.celebrate-mask {
  position: fixed;
  inset: 0;
  background: rgba(107, 79, 79, 0.35);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.confetti {
  position: fixed;
  top: -40rpx;
  border-radius: 30%;
  opacity: 0.95;
  animation: confettiFall 2.8s ease-in infinite;
}
@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
}
.celebrate-box {
  position: relative;
  background: #FFFBF8;
  border-radius: 44rpx;
  padding: 64rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(107, 79, 79, 0.25);
}
.praise {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8FA3;
}
.praise-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #B08E8E;
}
